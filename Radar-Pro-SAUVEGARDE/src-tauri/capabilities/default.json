
{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Autorisations de base pour RADAR PRO",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "C:/**"
        }
      ]
    }
  ]
}
