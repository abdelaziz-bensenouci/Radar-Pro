{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RADAR PRO",
  "version": "0.1.0",
  "identifier": "fr.radarpro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RADAR PRO",
        "width": 1440,
        "height": 920,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Veille territoriale des marchés publics",
    "category": "Business"
  }
}
